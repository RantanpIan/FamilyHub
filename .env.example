# Browser-safe Supabase project values. Never put service-role keys here.
# Add the app origin and /auth callback URLs to the Supabase Auth redirect allowlist.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set only when explicitly running the Supabase/PostgreSQL RLS integration suite.
# Use a local disposable Supabase stack; never point these at production.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
